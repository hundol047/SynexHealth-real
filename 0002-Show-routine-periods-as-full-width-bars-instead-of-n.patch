From a1f4aac89c59f82e59ecfbb731706cda84e2b31f Mon Sep 17 00:00:00 2001
From: ksg <sisungaa851@gmail.com>
Date: Sat, 31 Oct 2026 20:22:35 +0900
Subject: [PATCH] Show routine periods as full-width bars instead of nested
 boxes

- Render month and week headers as full-width collapsible bars; the
  month bar is tinted, the week bar is outlined.
- Drop the group border and body inset so day cards keep the full
  content width instead of narrowing at each nesting level.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 frontend/src/health/pages/RoutinePage.jsx |  9 +++++----
 frontend/src/shared/styles.css            | 13 +++++++++----
 2 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/frontend/src/health/pages/RoutinePage.jsx b/frontend/src/health/pages/RoutinePage.jsx
index 11ca34c..223b498 100644
--- a/frontend/src/health/pages/RoutinePage.jsx
+++ b/frontend/src/health/pages/RoutinePage.jsx
@@ -34,10 +34,11 @@ function DayCard({ latest, day, exs, onReplaced }) {
   );
 }
 
-function PeriodGroup({ title, badge, defaultOpen, children }) {
+// Periods render as full-width header bars over unboxed content, so month > week > day does not nest card in card.
+function PeriodGroup({ level, title, badge, defaultOpen, children }) {
   const [open, setOpen] = useState(defaultOpen);
   return (
-    <section className="period-group">
+    <section className={`period-group period-group--${level}`}>
       <button type="button" className="period-group-head" aria-expanded={open} onClick={() => setOpen((v) => !v)}>
         <strong>{title}</strong>{badge && <Badge>{badge}</Badge>}<ChevronDown size={18} className="period-group-chevron" />
       </button>
@@ -55,7 +56,7 @@ function RoutinePeriods({ routine, days, renderDay }) {
   const elapsed = Math.floor((Date.now() - Date.parse(routine.created_at)) / (7 * 86400000));
   const current = Number.isFinite(elapsed) ? Math.min(Math.max(elapsed, 0), totalWeeks - 1) + 1 : 1;
   const week = (w) => (
-    <PeriodGroup key={w} title={`${w}주차`} badge={w === current ? '이번 주' : null} defaultOpen={w === current}>
+    <PeriodGroup key={w} level="week" title={`${w}주차`} badge={w === current ? '이번 주' : null} defaultOpen={w === current}>
       {days.map(([day, exs]) => renderDay(day, exs))}
     </PeriodGroup>
   );
@@ -64,7 +65,7 @@ function RoutinePeriods({ routine, days, renderDay }) {
   return range(1, months).map((m) => {
     const weeks = range((m - 1) * 4 + 1, m * 4);
     return (
-      <PeriodGroup key={`m${m}`} title={`${m}개월차`} badge={weeks.includes(current) ? '진행 중' : null} defaultOpen={weeks.includes(current)}>
+      <PeriodGroup key={`m${m}`} level="month" title={`${m}개월차`} badge={weeks.includes(current) ? '진행 중' : null} defaultOpen={weeks.includes(current)}>
         {weeks.map(week)}
       </PeriodGroup>
     );
diff --git a/frontend/src/shared/styles.css b/frontend/src/shared/styles.css
index 6f9f08f..5284e55 100644
--- a/frontend/src/shared/styles.css
+++ b/frontend/src/shared/styles.css
@@ -124,13 +124,18 @@ small{font-size:.8125rem}
 .plan-period-units button.active{background:var(--blue);color:var(--white);font-weight:700}
 .plan-period-length{display:inline-flex;align-items:center;gap:8px;font-size:.875rem}
 .plan-period-length .text-input{width:80px}
-.period-group{border:1px solid var(--line);border-radius:var(--radius);background:var(--white);margin-bottom:12px}
-.period-group-head{display:flex;align-items:center;gap:8px;width:100%;min-height:52px;padding:10px 16px;text-align:left;color:var(--ink)}
+.period-group{margin-bottom:12px}
+.period-group-head{display:flex;align-items:center;gap:8px;width:100%;min-height:48px;padding:10px 16px;text-align:left;color:var(--ink);background:var(--white);border:1px solid var(--line);border-radius:var(--radius-sm)}
+.period-group-head:hover{background:var(--blue-pale)}
 .period-group-head strong{flex:1}
 .period-group-chevron{transition:transform .15s;color:var(--muted)}
 .period-group-head[aria-expanded=true] .period-group-chevron{transform:rotate(180deg)}
-.period-group-body{padding:0 12px 12px}
-.period-group-body .period-group{margin-bottom:8px}
+.period-group--month>.period-group-head{min-height:52px;background:var(--blue-light);border-color:transparent;color:var(--blue-dark)}
+.period-group--month>.period-group-head:hover{background:#dbe7ff}
+.period-group--month>.period-group-head .period-group-chevron{color:var(--blue-dark)}
+.period-group--month>.period-group-head .badge{background:var(--white)}
+.period-group-body{padding-top:12px}
+.period-group-body>.period-group:last-child{margin-bottom:0}
 
 /* Guided movement and explainable workout planning */
 .exercise-card { padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: #fff; }
-- 
