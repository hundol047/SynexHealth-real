+                  {region.label}<span className="muted" style={{ fontSize: '.72rem' }}>{region.hint}</span>
+                </label>
+              );
+            })}
+          </div>
+        </div>
+
+        <div style={{ marginTop: 14 }}>
+          <label className="field-label" htmlFor="rc-limitations">제약 사항 (쉼표로 구분)</label>
