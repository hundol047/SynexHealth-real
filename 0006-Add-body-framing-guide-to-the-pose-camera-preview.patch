+.camera-coaching .coach-feed .coach-framing-guide .coach-framing-body circle,.camera-coaching .coach-feed .coach-framing-guide .coach-framing-body path,.camera-coaching .coach-feed .coach-framing-guide .coach-framing-body line,.coach-feed .coach-framing-guide .coach-framing-body *{fill:#ffffff14;stroke:var(--frame);stroke-opacity:.95;transition:stroke .25s,opacity .25s}
+.camera-coaching .coach-feed .coach-framing-guide .coach-framing-body .coach-framing-floor{fill:none;stroke-opacity:.7}
+.camera-coaching .coach-feed .coach-framing-guide .coach-framing-edges line,.coach-feed .coach-framing-guide .coach-framing-edges line{stroke:#ef4444}
+.coach-feed .coach-framing-guide.is-ok .coach-framing-body{opacity:.55}
+.coach-framing-hint{position:absolute;z-index:2;left:50%;top:38px;transform:translateX(-50%);max-width:calc(100% - 20px);padding:5px 10px;border-radius:999px;background:#0b1a2bc4;color:#fff;font-size:11px;line-height:1.35;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}
+.coach-framing-hint.is-ok{background:#15803dd9}
+.coach-framing-hint.is-partial{background:#b45309e6}
+@media(max-width:600px){.coach-framing-hint{font-size:10px;top:34px;white-space:normal}}
